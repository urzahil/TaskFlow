<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (API < 31). The database runs with TRUNCATE journaling, so the
  main file is self-contained; -wal/-shm files are deliberately not backed up. Drive
  sync state is device specific and is not restored.
-->
<full-backup-content>
    <include
        domain="database"
        path="taskflow_database" />
    <include
        domain="sharedpref"
        path="taskflow_user_prefs.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup / device transfer rules (API 31+). See backup_rules.xml for rationale.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="taskflow_database" />
        <include
            domain="sharedpref"
            path="taskflow_user_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="taskflow_database" />
        <include
            domain="sharedpref"
            path="taskflow_user_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
